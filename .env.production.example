# ─────────────────────────────────────────
#  Sorteo App – Production Environment
#  Copia este archivo como .env y completa los valores
# ─────────────────────────────────────────

# Database (SQLite – ruta dentro del contenedor)
# El volumen Docker monta /app/db → esta variable la setea docker-entrypoint.sh
# NO es necesario definirla aquí si usas Docker con el entrypoint provisto.
DATABASE_URL=file:/app/db/custom.db

# Node environment
NODE_ENV=production

# Puerto del servidor Next.js (interno al contenedor)
PORT=3000
HOSTNAME=0.0.0.0

# Next.js – deshabilitar telemetría
NEXT_TELEMETRY_DISABLED=1

# ─── Opcionales / Futuras funcionalidades ───

# Si en el futuro agregas autenticación con next-auth:
# NEXTAUTH_URL=https://tu-dominio.com
# NEXTAUTH_SECRET=genera-un-secreto-con: openssl rand -base64 32
